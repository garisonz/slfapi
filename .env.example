# Local development only. Compose reads this from the repository root.
POSTGRES_PASSWORD=slfapi
POSTGRES_PORT=5432
SESSION_HOURS=24
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# For a backend running locally, put this in backend/.env.
# URL-encode special characters in the database password when writing a URL.
DATABASE_URL=postgresql+psycopg://slfapi:slfapi@localhost:5432/slfapi
